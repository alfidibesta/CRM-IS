# SecOps CRM — Apache hardening and performance (Laragon and any mod_php host).
# Nginx equivalents are documented in README.md.

# Every private folder is denied below. This keeps a mistake in that list from
# turning into a browsable index of backups/, uploads/ or logs/.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_authz_core.c>
  # Dotfiles are never web content: .htaccess, .git, .env, editor backups.
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
  # Archives, database files and backups are never served as static files.
  <FilesMatch "\.(sql|gz|tgz|tar|bz2|7z|rar|zip|md|log|ini|json|env|sh|bak|swp|swo|old|orig|dist|sqlite|db)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Evidence, library code, backups and test helpers are reachable only
  # through index.php (permission-checked) — never as static files.
  RewriteRule ^(uploads|lib|tests|logs|tools|backups)/ - [F,L]
  # Dot segments and dotfiles at any depth (assets/../.htaccess). .well-known
  # stays reachable in case a certificate check is added later.
  RewriteCond %{REQUEST_URI} !\.well-known/
  RewriteRule (^|/)\. - [F,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# The service worker must revalidate: a stale copy would keep serving old assets.
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Raise the upload ceiling where mod_php allows it, then uncomment. The app
# reads the effective limit from PHP and prints the real number in the UI.
# php_value upload_max_filesize 8M
# php_value post_max_size 10M
